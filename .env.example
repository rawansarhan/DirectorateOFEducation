# =============================================================================
# Directorate of Education — Backend Environment Variables
# انسخ هذا الملف إلى .env وعدّل القيم (لا ترفع .env إلى Git)
# =============================================================================

NODE_ENV=development
PORT=4000
API_PUBLIC_URL=http://localhost:4000
UPLOADS_DIR=

# ── PostgreSQL ───────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=directorate_education
DB_USER=postgres
DB_PASSWORD=your_db_password

# ── JWT (مطلوب — لا تستخدم القيم الافتراضية في الإنتاج) ─────────────────────
JWT_SECRET=change_me_to_a_long_random_secret
# اختياري — إن تُرك فارغاً يُستخدم JWT_SECRET
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=30d

# ── تشفير submit المشفر (32 بايت base64) ───────────────────────────────────
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SUBMIT_AES_KEY_BASE64=

# ── سلطة توقيع QR في PDF (Ed25519 — npm run keys:authority) ───────────────────
INTEGRITY_AUTHORITY_PRIVATE_KEY=
INTEGRITY_AUTHORITY_PUBLIC_KEY=

# ── Email (Gmail) ────────────────────────────────────────────────────────────
EMAIL_USER=your@gmail.com
EMAIL_PASS=your_app_password

# ── SMS (Traccar) ────────────────────────────────────────────────────────────
TRACCAR_URL=https://your-traccar-host/api
TRACCAR_TOKEN=your_traccar_token

# ── Cloudinary (اختياري) ───────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Camunda ──────────────────────────────────────────────────────────────────
CAMUNDA_URL=http://localhost:8080/engine-rest
CAMUNDA_TIMEOUT_MS=30000

# ── Redis (اختياري — للكاش) ─────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── عناوين الخدمات الداخلية ─────────────────────────────────────────────────
TRANSACTION_SERVICE_URL=http://localhost:4000
WORKFLOW_SERVICE_URL=http://localhost:4000
ORGANIZATION_SERVICE_URL=http://localhost:4000
AUTH_SERVICE_URL=http://localhost:4000

# ── Auth TTL ─────────────────────────────────────────────────────────────────
AUTH_CHALLENGE_TTL_MS=300000
PIN_SESSION_TTL_MS=900000
TX_SIGN_TTL_MS=300000
OTP_TTL_MINUTES=10
BCRYPT_ROUNDS=10

# ── Security / Account lock ──────────────────────────────────────────────────
SECURITY_MAX_FAILED_ATTEMPTS=5
SECURITY_LOCK_DURATION_MS=900000
OPERATION_MIN_INTERVAL_MS=2000
IDEMPOTENCY_TTL_MS=86400000
OPERATION_GUARD_CLEANUP_MS=60000

# ── Rate limits ──────────────────────────────────────────────────────────────
RATE_LIMIT_AUTH_WINDOW_MS=60000
RATE_LIMIT_AUTH_MAX=20
RATE_LIMIT_AUTH_BRUTE_WINDOW_MS=900000
RATE_LIMIT_AUTH_BRUTE_MAX=10
RATE_LIMIT_SIGN_WINDOW_MS=60000
RATE_LIMIT_SIGN_MAX=10
RATE_LIMIT_COMPLETE_WINDOW_MS=60000
RATE_LIMIT_COMPLETE_MAX=15
RATE_LIMIT_SUBMIT_WINDOW_MS=60000
RATE_LIMIT_SUBMIT_MAX=10
RATE_LIMIT_FINAL_DOC_WINDOW_MS=10000
RATE_LIMIT_FINAL_DOC_MAX=3
RATE_LIMIT_UPLOAD_WINDOW_MS=60000
RATE_LIMIT_UPLOAD_MAX=15

# ── Upload limits ────────────────────────────────────────────────────────────
TRANSACTION_FILE_MAX_MB=25
TRANSACTION_UPLOAD_DAILY_MAX_FILES=50
TRANSACTION_UPLOAD_DAILY_MAX_MB=200
TASK_LOCK_TTL_MS=900000

# ── Cache TTL (seconds) ────────────────────────────────────────────────────
API_CACHE_TTL_SECONDS=3600
PROCESS_CACHE_TTL_SECONDS=3600
EMPLOYEE_TASKS_CACHE_TTL_SECONDS=60
FINAL_DOCUMENT_CACHE_TTL_SECONDS=3600
TASK_DETAILS_CACHE_TTL_SECONDS=30
CURRENT_STAGE_CACHE_TTL_SECONDS=600

# ── WebSocket ────────────────────────────────────────────────────────────────
WS_PATH=/ws
WS_PORT=4100
WS_DEMO=false
WS_DEMO_INTERVAL_MS=15000

# ── PDF ──────────────────────────────────────────────────────────────────────
PDF_ARABIC_SHAPING=logical
PDF_UNICODE_FONT_PATH=
REPUBLIC_LOGO_PATH=

# ── Jobs / Cron ──────────────────────────────────────────────────────────────
OUTBOX_POLL_INTERVAL_MS=5000
PROCESS_ACTIVATION_CRON=* * * * *
SERVICE_TASK_SYNC_ENABLED=true
SERVICE_TASK_SYNC_CRON=*/1 * * * *
SERVICE_TASK_SYNC_BATCH_SIZE=40
SERVICE_TASK_SYNC_CONCURRENCY=3
SERVICE_TASK_SYNC_STALE_MS=120000
COMPLETE_RECOVERY_BATCH_SIZE=20
COMPLETE_RECOVERY_CONCURRENCY=2
COMPLETE_RECOVERY_MAX_ATTEMPTS=30
RETRY_MAX_ATTEMPTS=3
RETRY_BASE_DELAY_MS=300
RETRY_MAX_DELAY_MS=5000
