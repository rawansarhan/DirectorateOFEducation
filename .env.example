# Server
PORT=4000
API_PUBLIC_URL=http://localhost:4000
NODE_ENV=development

# Database
DB_HOST=127.0.0.1
DB_NAME=DirectorateOFEducation
DB_USER=postgres
DB_PASSWORD=your_db_password
DB_PORT=5000

# Auth
JWT_SECRET=change_me_to_a_long_random_secret
JWT_EXPIRES_IN=30d
OTP_TTL_MINUTES=5
BCRYPT_ROUNDS=10

# Email (SMTP)
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password

# Cloudinary (optional)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Camunda
CAMUNDA_URL=http://localhost:8081/engine-rest

# Traccar SMS Gateway
TRACCAR_URL=https://www.traccar.org/sms/
TRACCAR_TOKEN=your_traccar_token

# Redis (leave empty to disable caching)
REDIS_URL=redis://127.0.0.1:6380

# Internal service URLs (monolith: same host/port)
TRANSACTION_SERVICE_URL=http://localhost:4000
WORKFLOW_SERVICE_URL=http://localhost:4000
ORGANIZATION_SERVICE_URL=http://localhost:4000
AUTH_SERVICE_URL=http://localhost:4000

# Cache TTL (seconds)
API_CACHE_TTL_SECONDS=3600
PROCESS_CACHE_TTL_SECONDS=3600

# Idempotency & operation guard
OPERATION_MIN_INTERVAL_MS=2000
IDEMPOTENCY_TTL_MS=86400000
OPERATION_GUARD_CLEANUP_MS=60000

# Account lockout
SECURITY_MAX_FAILED_ATTEMPTS=5
SECURITY_LOCK_DURATION_MS=900000

# Rate limiting
RATE_LIMIT_AUTH_WINDOW_MS=60000
RATE_LIMIT_AUTH_MAX=20
RATE_LIMIT_AUTH_BRUTE_WINDOW_MS=900000
RATE_LIMIT_AUTH_BRUTE_MAX=10
RATE_LIMIT_SIGN_WINDOW_MS=60000
RATE_LIMIT_SIGN_MAX=10
RATE_LIMIT_COMPLETE_WINDOW_MS=60000
RATE_LIMIT_COMPLETE_MAX=15
RATE_LIMIT_SUBMIT_WINDOW_MS=60000
RATE_LIMIT_SUBMIT_MAX=10

# Task lock
TASK_LOCK_TTL_MS=1800000

# Crypto auth TTL (milliseconds)
AUTH_CHALLENGE_TTL_MS=300000
PIN_SESSION_TTL_MS=300000
TX_SIGN_TTL_MS=300000

# Background jobs
OUTBOX_POLL_INTERVAL_MS=1000
PROCESS_ACTIVATION_CRON=* * * * *
